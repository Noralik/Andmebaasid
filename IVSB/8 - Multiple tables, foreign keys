Homework

/*what rooms are available at 2025-03-10 for 3 people with balcony?*/
SELECT
    r.room_number,
    r.double_beds,
    r.single_beds
FROM Room AS r
WHERE r.has_balcony = 1
AND (r.double_beds * 2 + r.single_beds) >= 3
AND r.room_number NOT IN (
    SELECT b.room_id
    FROM Booking AS b
    WHERE b.check_in <= '2025-03-10'
    AND b.check_out > '2025-03-10'
);
  
 -- ----------------------------------------------------------- 
  
  /*how many rooms has each person stayed in?*/
SELECT
    COUNT(DISTINCT b.room_id) AS rooms_stayed,
    g.guest_id,
    g.name
FROM Booking AS b
JOIN Guest AS g ON b.guest_id = g.guest_id
GROUP BY g.guest_id, g.name;

-- -----------------------------------------------------------

/*how many people did they bring with in this period?*/
SELECT
    SUM(b.number_of_guests - 1) AS people_brought,
    g.guest_id,
    g.name
FROM Booking AS b
JOIN Guest AS g ON b.guest_id = g.guest_id
WHERE b.check_in <= '2025-03-10'
AND b.check_out > '2025-03-10'
GROUP BY g.guest_id, g.name;
