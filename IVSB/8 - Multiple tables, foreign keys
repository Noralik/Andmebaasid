-- What rooms are available at 2025-03-10?

SELECT
    r.room_number
FROM Room AS r
WHERE r.room_number NOT IN (
    SELECT b.room_id
    FROM Booking AS b
    WHERE b.check_in <= '2025-03-10'
    AND b.check_out > '2025-03-10'
);

